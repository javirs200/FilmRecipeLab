{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FilmRecipeLab: compilar solución",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/FilmRecipeLab.sln",
                "--no-restore"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "FilmRecipeLab: restaurar y compilar solución",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/FilmRecipeLab.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "FilmRecipeLab: ejecutar tests",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/FilmRecipeLab.sln",
                "--no-restore"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "FilmRecipeLab: publicar EXE Release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/src/FilmRecipeLab.Presentation/FilmRecipeLab.Presentation.csproj",
                "-c",
                "Release",
                "-r",
                "win-x64",
                "--self-contained",
                "true",
                "-p:PublishSingleFile=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true",
                "-o",
                "${workspaceFolder}/publish/FilmRecipeLab"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
